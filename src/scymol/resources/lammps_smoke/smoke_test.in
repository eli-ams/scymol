# =============================================================================
# protocol_01_nvt
# Generated by Scymol
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 01: Initialization
# Initialize LAMMPS and read the molecular topology.
# -----------------------------------------------------------------------------
log stages/01_initialization/log.lammps
units real
boundary p p p
atom_style full
pair_style lj/cut 12.0
pair_modify mix arithmetic
bond_style harmonic
angle_style harmonic
dihedral_style fourier
improper_style cvff
special_bonds amber
read_data structure.data
thermo_style custom step time press vol density temp ebond eangle edihed eimp evdwl ecoul pe ke
thermo_modify flush yes
write_data stages/01_initialization/structure.data

# -----------------------------------------------------------------------------
# Stage 02: Minimization
# Energy minimization.
# -----------------------------------------------------------------------------
log stages/02_minimization/log.lammps
min_style cg
min_modify dmax 0.05
thermo 100
dump scy_min all custom 1000 stages/02_minimization/trajectory.lammpstrj id mol type q x y z
minimize 0.0 0.0 1000 10000
undump scy_min
write_data stages/02_minimization/structure.data

# -----------------------------------------------------------------------------
# Stage 03: Velocities
# Create initial velocities.
# -----------------------------------------------------------------------------
log stages/03_velocities/log.lammps
velocity all create 298.15 1234 dist gaussian mom yes rot yes
write_data stages/03_velocities/structure.data

# -----------------------------------------------------------------------------
# Stage 04: NVT
# NVT molecular dynamics.
# -----------------------------------------------------------------------------
log stages/04_nvt/log.lammps
reset_timestep 0
thermo 1000
thermo_style custom step time press vol density temp ebond eangle edihed eimp evdwl ecoul pe ke
fix scy_ensemble all nvt temp 298.15 298.15 100.0 drag 1.0
dump scy_dump all custom 1000 stages/04_nvt/trajectory.lammpstrj id mol type q x y z
timestep 1.0
run 5000
unfix scy_ensemble
undump scy_dump
write_data stages/04_nvt/structure.data
print "SCYMOL_SMOKE_TEST_OK"
